{
  "name": "dsh-snap-line",
  "version": "1.3.0",
  "description": "Hangs a clothesline of polaroid photos under the message composer in DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "LMhuo (https://github.com/LMhuo)",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "clothesline",
    "polaroid",
    "photo",
    "decoration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMhuo/dsh-snap-line.git"
  },
  "homepage": "https://github.com/LMhuo/dsh-snap-line#readme",
  "bugs": {
    "url": "https://github.com/LMhuo/dsh-snap-line/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": "^0.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/images"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/photos.js && node --test",
    "test": "node --test"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
